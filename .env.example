APP_NAME=Agentic Career Search
DATABASE_URL=sqlite+aiosqlite:///./autoapply_agent.db
WORKER_POLL_INTERVAL_SECONDS=0.5
HTTP_TIMEOUT_SECONDS=12.0
MAX_JOBS_PER_SOURCE=50
HTTP_USER_AGENT=agentic-career-search/0.2
ENABLE_WORKER=true
LLM_ENABLE_ENRICHMENT=false
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=12.0

# Gemini (gemini-3.8-flash; gemini-4-hydrogen is Google's recommended upgrade, 2x the price
# through 2026-12-31; gemini-4-argon / gemini-4-carbon for harder reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Kimi (Moonshot, OpenAI-compatible API; K3 models fix temperature at 1.0;
# K2 models are retiring by the end of December 2026)
KIMI_API_KEY=
KIMI_MODEL=kimi-k3.1-pro
# Mainland-China accounts use https://api.moonshot.cn/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Claude (claude-haiku-5-5 for high-volume enrichment; claude-sonnet-5-5 / claude-opus-5-5 /
# claude-fable-5-2, which needs 30-day data retention)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# GPT (OpenAI-compatible API; gpt-6-luna is the cheapest GPT-6 model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max (gpt-6.1-sol / gpt-6-astra need low or higher;
# leave empty for gateways without reasoning_effort)
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1

# Priority alert webhook (Slack/Discord/custom) — fail-soft, high tier only
PRIORITY_ALERT_WEBHOOK_ENABLED=false
PRIORITY_ALERT_WEBHOOK_URL=
PRIORITY_ALERT_WEBHOOK_TIMEOUT_SECONDS=5.0
